FORENSIX_ENVIRONMENT=development
FORENSIX_DATA_DIR=data
FORENSIX_ADB_MODE=system
# FORENSIX_MOCK_ADB_SCENARIO=authorized
# FORENSIX_ADB_PATH=C:\Android\platform-tools\adb.exe
# Optional official scrcpy executable for live mirroring and control.
# FORENSIX_SCRCPY_PATH=C:\ForensicTools\scrcpy\scrcpy.exe
# Optional but recommended: pin the exact scrcpy.exe SHA-256.
# FORENSIX_SCRCPY_EXPECTED_SHA256=replace_with_64_lowercase_hex_characters
# Optional TestDisk/PhotoRec external recovery. It operates only on verified raw ext4/F2FS
# Evidence Twin working copies, never a live Android device or sealed master source.

# ==============================================================================
# Feature Flags & Integrations
# ==============================================================================

# Enable HTTPS/TLS instead of loopback transport for remote access.
# FORENSIX_DEPLOYMENT_TRANSPORT=https

# Groq Cloud API Key for AI-generated case narratives (llama-3.1-8b-instant).
# Get a free key at: https://console.groq.com/keys
# FORENSIX_GROQ_API_KEY=gsk_your_groq_api_key_here

# FORENSIX_PHOTOREC_PATH=C:\ForensicTools\testdisk\photorec_win.exe
# FORENSIX_PHOTOREC_EXPECTED_SHA256=replace_with_64_lowercase_hex_characters
# FORENSIX_PHOTOREC_TIMEOUT_SECONDS=7200
# FORENSIX_PHOTOREC_MAX_OUTPUT_FILES=10000
# FORENSIX_PHOTOREC_MAX_OUTPUT_BYTES=17179869184
FORENSIX_API_HOST=127.0.0.1
FORENSIX_API_PORT=8765
FORENSIX_SESSION_TTL_MINUTES=480
FORENSIX_LOGIN_MAX_FAILURES=5
FORENSIX_LOGIN_LOCKOUT_MINUTES=15
# Optional ALEAPP v2026.1.0 integration. Verify the downloaded asset yourself and pin its digest.
# FORENSIX_ALEAPP_PROGRAM_PATH=C:\ForensicTools\ALEAPP\aleapp.py
# FORENSIX_ALEAPP_PYTHON_EXECUTABLE=C:\Python312\python.exe
# FORENSIX_ALEAPP_EXPECTED_SHA256=replace_with_64_lowercase_hex_characters
# FORENSIX_ALEAPP_RELEASE_LABEL=v2026.1.0
# FORENSIX_ALEAPP_TIMEOUT_SECONDS=1800
# Experimental and disabled by default. This never bypasses Android encryption or locks.
FORENSIX_ENABLE_EXPERIMENTAL_PHYSICAL_ACQUISITION=false
FORENSIX_MAX_PHYSICAL_ACQUISITION_BYTES=137438953472
